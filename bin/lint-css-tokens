#!/usr/bin/env ruby
# bin/lint-css-tokens
#
# Enforces the issue #44 theme convention: app/assets/stylesheets/application.css
# is the single source of truth for design tokens.
#
# Rules:
#   1. app/views/**  — no hex/rgb/hsl colour literals, no <style> blocks, and no
#                      Tailwind arbitrary-value utilities (w-[13px], text-[#fff]).
#   2. app/assets/stylesheets/** (except application.css) — no literal colours;
#                      use `rgb(var(--color-…))` instead.
#   3. config/tailwind.config.js — no literal colours; map tokens with rgb(var()).
#
# Exit non-zero if any violation is found.

require "pathname"

ROOT = Pathname.new(__dir__).parent
TOKENS_FILE = "app/assets/stylesheets/application.css"

# Files that are not UI views (JSON manifest, mailers) are excluded from rule 1.
EXCLUDED_VIEWS = %w[
  pwa/manifest.json.erb
  layouts/mailer.html.erb
  layouts/mailer.text.erb
].freeze

# Tailwind arbitrary values appear as `<utility>-[value]` inside class attributes.
ARBITRARY_VALUE = /\b[a-z]+-\[[^\]]+\]/
HEX_COLOR = /#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})\b/
LITERAL_RGB = /rgba?\(\s*\d/
LITERAL_HSL = /hsla?\(\s*\d/
STYLE_BLOCK = /<style\b/i

violations = []

def relative(path)
  path.to_s.sub("#{ROOT}/", "")
end

# ── 1. Views ────────────────────────────────────────────────────────────────
Dir[ROOT.join("app", "views", "**", "*.erb")].sort.each do |file|
  name = relative(file)
  next if EXCLUDED_VIEWS.any? { |excluded| name.include?(excluded) }

  content = File.read(file)

  content.scan(ARBITRARY_VALUE) do |match|
    violations << "#{name}: Tailwind arbitrary value #{match.inspect} found"
  end

  content.scan(HEX_COLOR) do |match|
    violations << "#{name}: hex colour #{match.inspect} found"
  end

  violations << "#{name}: literal rgb()/rgba() colour found" if content.match?(LITERAL_RGB)
  violations << "#{name}: literal hsl()/hsla() colour found" if content.match?(LITERAL_HSL)
  violations << "#{name}: <style> block found" if content.match?(STYLE_BLOCK)
end

# ── 2. Stylesheets (application.css owns the raw values) ────────────────────
Dir[ROOT.join("app", "assets", "stylesheets", "**", "*.css")].sort.each do |file|
  name = relative(file)
  next if name == TOKENS_FILE

  content = File.read(file)

  content.scan(HEX_COLOR) do |match|
    violations << "#{name}: hex colour #{match.inspect} found (use a token)"
  end
  violations << "#{name}: literal rgb()/rgba() colour found (use rgb(var(--color-…)))" if content.match?(LITERAL_RGB)
  violations << "#{name}: literal hsl()/hsla() colour found (use a token)" if content.match?(LITERAL_HSL)
end

# ── 3. Tailwind config ──────────────────────────────────────────────────────
config = ROOT.join("config", "tailwind.config.js")
if config.exist?
  content = File.read(config)
  content.scan(HEX_COLOR) do |match|
    violations << "config/tailwind.config.js: hex colour #{match.inspect} found (map a token instead)"
  end
  violations << "config/tailwind.config.js: literal rgb()/rgba() colour found (map a token instead)" if content.match?(LITERAL_RGB)
  violations << "config/tailwind.config.js: literal hsl()/hsla() colour found (map a token instead)" if content.match?(LITERAL_HSL)
end

if violations.any?
  puts "CSS token lint violations:"
  violations.each { |violation| puts "  #{violation}" }
  puts
  puts "Design tokens (colours, spacing, radii, shadows, type, motion) live in #{TOKENS_FILE}."
  puts "Views must use semantic utilities (bg-surface, text-text, border-border, …)."
  exit 1
else
  puts "CSS token lint: no violations."
  exit 0
end
