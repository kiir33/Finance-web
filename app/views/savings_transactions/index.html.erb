<%= content_for :title, "Savings Transactions" %>

<h1 class="text-2xl font-bold mb-6">Savings Transactions</h1>

<% if current_user.admin? %>
  <%= link_to "New Transaction", new_savings_transaction_path, class: "btn btn-primary mb-4" %>
<% end %>

<table class="table">
  <thead>
    <tr>
      <th>Account</th>
      <th>Type</th>
      <th>Amount</th>
      <th>Date</th>
    </tr>
  </thead>
  <tbody>
    <%= render partial: "shared/savings_transaction", collection: @transactions, as: :transaction %>
  </tbody>
</table>
