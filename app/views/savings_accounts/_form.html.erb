<%= form_with model: account, local: true do |form| %>
  <%= render "shared/form_errors", object: form.object %>
  <%= form.hidden_field :lock_version %>

  <div class="mb-4">
    <%= form.label :member_id, "Member", class: "form-label" %>
    <%= form.collection_select :member_id, @members, :id, :member_id, {}, class: "form-input" %>
  </div>

  <div>
    <%= form.submit account.persisted? ? "Update" : "Create", class: "btn btn-primary" %>
    <%= link_to "Cancel", savings_accounts_path, class: "btn btn-outline ml-2" %>
  </div>
<% end %>