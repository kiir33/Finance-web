<%= content_for :title, "Clients" %>

<h1 class="text-2xl font-bold mb-6">Clients</h1>

<%= link_to "New Client", new_client_path, class: "btn btn-primary mb-4" %>

<table class="table">
  <thead>
    <tr>
      <th>Client ID</th>
      <th>Name</th>
      <th>Phone</th>
      <th>Address</th>
      <th class="text-right">Actions</th>
    </tr>
  </thead>
  <tbody>
    <% @clients.each do |client| %>
      <tr>
        <td><%= client.client_id %></td>
        <td><%= link_to client.name, client_path(client) %></td>
        <td><%= client.phone_number %></td>
        <td><%= client.address %></td>
        <td class="text-right">
          <%= link_to "Edit", edit_client_path(client), class: "btn btn-outline mb-1" %>
          <%= button_to "Archive", client_path(client), method: :delete, class: "btn btn-danger mb-1" %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
