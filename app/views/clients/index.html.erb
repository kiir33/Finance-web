<%= content_for :title, "Clients" %>

<h1 class="text-2xl font-bold mb-6">Clients</h1>

<% if current_user.admin? %>
  <%= link_to "New Client", new_client_path, class: "btn btn-primary mb-4" %>
<% end %>

<table class="table">
  <thead>
    <tr>
      <th>Client ID</th>
      <th>Name</th>
      <th>Phone</th>
      <th>Address</th>
      <th class="text-right">Actions</th>
    </tr>
  </thead>
  <tbody>
    <%= render partial: "shared/client", collection: @clients, as: :client %>
  </tbody>
</table>
