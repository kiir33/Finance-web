<%= content_for :title, "System Configs" %>

<h1 class="text-2xl font-bold mb-6">System Configs</h1>

<% if current_user.admin? %>
  <%= link_to "New Config", new_system_config_path, class: "btn btn-primary mb-4" %>
<% end %>

<table class="table">
  <thead>
    <tr>
      <th>Key</th>
      <th>Value</th>
      <th>Type</th>
      <th>Description</th>
      <th class="text-right">Actions</th>
    </tr>
  </thead>
  <tbody>
    <%= render partial: "shared/system_config", collection: @configs, as: :config %>
  </tbody>
</table>
