<%= content_for :title, "System Configs" %>

<h1 class="text-2xl font-bold mb-6">System Configs</h1>

<% if current_user.admin? %>
  <%= link_to "New Config", new_system_config_path, class: "btn btn-primary mb-4" %>
<% end %>

<table class="table">
  <thead>
    <tr>
      <th>Key</th>
      <th>Value</th>
      <th>Type</th>
      <th>Description</th>
      <th class="text-right">Actions</th>
    </tr>
  </thead>
  <tbody>
    <% @configs.each do |config| %>
      <tr>
        <td><%= config.config_key %></td>
        <td><%= config.config_value %></td>
        <td><%= config.config_type %></td>
        <td><%= config.description %></td>
        <td class="text-right">
          <%= link_to "Show", system_config_path(config.config_key), class: "btn btn-outline mb-1" %>
          <% if current_user.admin? %>
            <%= link_to "Edit", edit_system_config_path(config.config_key), class: "btn btn-outline mb-1" %>
            <%= button_to "Delete", system_config_path(config.config_key), method: :delete, class: "btn btn-danger mb-1" %>
          <% end %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
