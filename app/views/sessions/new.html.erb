<%= content_for :title, "Log in" %>

<div class="auth-card card">
  <div class="auth-header text-center mb-6">
    <%= link_to root_path, class: "auth-brand flex items-center justify-center gap-2 text-primary font-bold text-lg" do %>
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M3 14h18m-9-4v8m-7 0h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
      </svg>
      FinanceApp
    <% end %>
    <h1 class="text-2xl font-bold mt-2">Log in</h1>
    <p class="text-text-muted text-sm">Enter your email and password to sign in.</p>
  </div>

  <%= form_with url: session_path, local: true, data: { controller: "auth-form", action: "submit->auth-form#disableSubmit" } do |form| %>
    <% if flash[:alert] %>
      <div role="alert" class="mb-4 p-3 rounded-md bg-danger/10 border border-danger/20 text-danger text-sm">
        <%= flash[:alert] %>
      </div>
    <% end %>

    <div class="field space-y-4">
      <div class="input-group">
        <%= form.label :email, class: "block text-sm font-medium text-text mb-1" do %>
          Email address
        <% end %>
        <div class="relative">
          <%= form.email_field :email, type: "email", autocomplete: "username", required: true,
            class: "input w-full rounded-md border-border bg-surface text-text placeholder:text-text-muted focus:ring-2 focus:ring-border-focus focus:border-transparent transition-colors",
            placeholder: "you@example.com" %>
        </div>
      </div>

      <div class="input-group">
        <%= form.label :password, class: "block text-sm font-medium text-text mb-1 flex justify-between items-baseline" do %>
          Password
        <% end %>
        <div class="relative">
          <%= form.password_field :password, autocomplete: "current-password", required: true,
            data: { "auth-form-target": "password" },
            class: "input w-full pr-10 rounded-md border-border bg-surface text-text placeholder:text-text-muted focus:ring-2 focus:ring-border-focus focus:border-transparent transition-colors",
            placeholder: "••••••••" %>
          <button type="button"
            data-action="auth-form#togglePassword"
            class="absolute right-3 top-1/2 -translate-y-1/2 text-text-muted hover:text-text focus:outline-none focus:ring-2 focus:ring-border-focus rounded-md p-1.5"
            aria-label="Show password"
            aria-pressed="false">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7m-11.5 2c1.732-4.058 5.523-7 10-7s8.268 2.943 9.542 7m-11.5 2c-1.732 4.058-5.523 7-10 7s-8.268-2.943-9.542-7m10 0c-4.478 0-8.268-2.943-9.542-7m-4.542 7c1.732 4.058 5.523 7 10 7s8.268-2.943 9.542-7m-10-7c1.732-4.058 5.523-7 10-7s8.268 2.943 9.542 7" />
            </svg>
          </button>
        </div>
      </div>

      <div class="actions flex items-center justify-between">
        <%= form.submit "Log in",
          data: { "auth-form-target": "submit" },
          class: "btn btn-primary w-full md:w-auto disabled:opacity-50 disabled:cursor-not-allowed" %>
      </div>
    </div>

    <p class="mt-6 text-center text-sm text-text-muted">
      Don't have an account? Contact an administrator to create one.
    </p>
  <% end %>
</div>
