<aside id="sidebar" class="sidebar" data-controller="sidebar" data-sidebar-target="sidebar" role="navigation" aria-label="Main navigation">
  <div class="sidebar-header">
    <%= link_to "FinanceApp", root_path, class: "sidebar-brand" %>
    <button type="button" class="sidebar-toggle" data-action="sidebar#toggle" data-sidebar-target="toggleButton" aria-label="Toggle sidebar" aria-expanded="true">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>

  <nav class="sidebar-nav">
    <% if user_signed_in? %>
      <div class="sidebar-user">
        <span class="sidebar-user-email"><%= current_user.email %></span>
        <span class="sidebar-user-role"><%= current_user.role.humanize %></span>
      </div>

      <ul class="sidebar-menu">
        <li>
          <%= link_to root_path, class: "sidebar-link", data: { sidebar_target: "navLink", tooltip: "Dashboard" } do %>
            <svg class="sidebar-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" /></svg>
            <span class="sidebar-label">Dashboard</span>
          <% end %>
        </li>

        <% if current_user.admin? %>
          <li class="sidebar-section">
            <span class="sidebar-section-title">Administration</span>
          </li>

          <li>
            <%= link_to clients_path, class: "sidebar-link", data: { sidebar_target: "navLink", tooltip: "Clients" } do %>
              <svg class="sidebar-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" /></svg>
              <span class="sidebar-label">Clients</span>
            <% end %>
          </li>

          <li>
            <%= link_to loans_path, class: "sidebar-link", data: { sidebar_target: "navLink", tooltip: "Loans" } do %>
              <svg class="sidebar-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
              <span class="sidebar-label">Loans</span>
            <% end %>
          </li>

          <li>
            <%= link_to savings_accounts_path, class: "sidebar-link", data: { sidebar_target: "navLink", tooltip: "Savings" } do %>
              <svg class="sidebar-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
              <span class="sidebar-label">Savings</span>
            <% end %>
          </li>

          <li>
            <%= link_to system_configs_path, class: "sidebar-link", data: { sidebar_target: "navLink", tooltip: "System Configs" } do %>
              <svg class="sidebar-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
              <span class="sidebar-label">System Configs</span>
            <% end %>
          </li>

          <li>
            <%= link_to audit_logs_path, class: "sidebar-link", data: { sidebar_target: "navLink", tooltip: "Audit Logs" } do %>
              <svg class="sidebar-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
              <span class="sidebar-label">Audit Logs</span>
            <% end %>
          </li>

          <li class="sidebar-section">
            <span class="sidebar-section-title">Treasury</span>
          </li>

          <li>
            <%= link_to group_account_path(GroupAccount.where(deleted_at: nil).first), class: "sidebar-link", data: { sidebar_target: "navLink", tooltip: "Group Treasury" } do %>
              <svg class="sidebar-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
              <span class="sidebar-label">Group Treasury</span>
            <% end %>
          </li>
        <% else %>
          <li>
            <%= link_to edit_password_path, class: "sidebar-link", data: { sidebar_target: "navLink", tooltip: "Profile" } do %>
              <svg class="sidebar-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" /></svg>
              <span class="sidebar-label">Profile</span>
            <% end %>
          </li>
        <% end %>

        <li>
          <%= button_to destroy_session_path, method: :delete, class: "sidebar-link sidebar-link-danger", data: { sidebar_target: "navLink", tooltip: "Logout" } do %>
            <svg class="sidebar-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" /></svg>
            <span class="sidebar-label">Logout</span>
          <% end %>
        </li>
      </ul>
    <% else %>
      <div class="sidebar-cta">
        <%= link_to "Sign in", new_session_path, class: "btn btn-primary w-full" %>
      </div>
    <% end %>
  </nav>

  <!-- Mobile backdrop -->
  <div id="sidebar-backdrop" class="sidebar-backdrop" data-action="sidebar#close" aria-hidden="true"></div>
</aside>