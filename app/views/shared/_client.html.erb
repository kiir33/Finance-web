<%= content_tag :tr, class: "client-row" do %>
  <td><%= client.client_id %></td>
  <td><%= link_to client.name, client_path(client) %></td>
  <td><%= client.phone_number %></td>
  <td><%= client.address %></td>
  <td class="text-right">
    <% if current_user.admin? %>
      <%= link_to "Edit", edit_client_path(client), class: "btn btn-outline mb-1" %>
      <%= button_to "Archive", client_path(client), method: :delete, class: "btn btn-danger mb-1" %>
    <% end %>
  </td>
<% end %>