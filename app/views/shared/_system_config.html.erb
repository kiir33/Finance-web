<%= content_tag :tr, class: "system-config-row" do %>
  <td><%= config.config_key %></td>
  <td><%= config.config_value %></td>
  <td><%= config.config_type %></td>
  <td><%= config.description %></td>
  <td class="text-right">
    <%= link_to "Show", system_config_path(config.config_key), class: "btn btn-outline mb-1" %>
    <% if current_user.admin? %>
      <%= link_to "Edit", edit_system_config_path(config.config_key), class: "btn btn-outline mb-1" %>
      <%= button_to "Delete", system_config_path(config.config_key), method: :delete, class: "btn btn-danger mb-1" %>
    <% end %>
  </td>
<% end %>