<%# Concurrent edit conflict modal - shown when optimistic locking detects a conflict %>
<%# Expects @concurrency_conflict hash with :record, :submitted_params, :record_type %>

<% if @concurrency_conflict.present? %>
  <% record = @concurrency_conflict[:record] %>
  <% record_type = @concurrency_conflict[:record_type] %>
  <% submitted = @concurrency_conflict[:submitted_params] %>
  <% param_key = record.class.model_name.param_key %>
  <% edit_path = send("edit_#{param_key}_path", record) %>
  <% update_path = send("#{param_key}_path", record) %>
  <% original_lock_version = submitted[:lock_version] %>

  <div id="concurrency-conflict-modal" class="modal-overlay" role="dialog" aria-modal="true" aria-labelledby="conflict-modal-title">
    <div class="modal-container">
      <div class="modal-header">
        <h2 id="conflict-modal-title" class="modal-title">Concurrent Edit Conflict</h2>
      </div>

      <div class="modal-body">
        <div class="alert alert-warning mb-4">
          <svg class="w-5 h-5 inline mr-2" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
            <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
          </svg>
          <strong>Conflict detected:</strong> This record was modified by another session while you were editing.
        </div>

        <div class="conflict-comparison">
          <h3 class="text-sm font-medium text-text mb-3">Your Changes (Unsaved)</h3>
          <div class="bg-surface-muted rounded-lg p-4 mb-4 overflow-auto max-h-64">
            <table class="table table-sm">
              <thead>
                <tr><th>Field</th><th>Your Value</th></tr>
              </thead>
              <tbody>
                <% submitted.each do |key, value| %>
                  <% next if key.in?(%w[lock_version _method authenticity_token commit force_update]) %>
                  <tr>
                    <td class="font-medium"><%= key.humanize %></td>
                    <td><%= value.presence || "<em class='text-text-muted'>(empty)</em>".html_safe %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>

          <h3 class="text-sm font-medium text-text mb-3">Current Server Version</h3>
          <div class="bg-info/10 rounded-lg p-4 mb-4 overflow-auto max-h-64">
            <table class="table table-sm">
              <thead>
                <tr><th>Field</th><th>Server Value</th></tr>
              </thead>
              <tbody>
                <% record.attributes.each do |key, value| %>
                  <% next if key.in?(%w[id created_at updated_at lock_version deleted_at public_id]) %>
                  <tr>
                    <td class="font-medium"><%= key.humanize %></td>
                    <td><%= value.presence || "<em class='text-text-muted'>(empty)</em>".html_safe %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>

        <p class="text-sm text-text-muted mb-4">Choose how to proceed:</p>

        <div class="flex gap-3">
          <%# Discard button - reloads the edit page with server data %>
          <%= button_to "Discard My Changes", edit_path, method: :get, class: "btn btn-outline", form: { data: { turbo: false } } %>

          <%# Save button - submits with force flag to overwrite %>
          <%= form_with url: update_path, method: :patch, local: true, class: "inline" do |form| %>
            <% submitted.each do |key, value| %>
              <% next if key.in?(%w[lock_version _method authenticity_token commit force_update]) %>
              <%= form.hidden_field key, value: value %>
            <% end %>
            <%= form.hidden_field :force_update, value: "true" %>
            <%= form.hidden_field :lock_version, value: original_lock_version %>
            <%= form.submit "Save Anyway (Overwrite)", class: "btn btn-danger" %>
          <% end %>
        </div>
      </div>
    </div>
  </div>


  <script>
    // Auto-focus the modal for accessibility
    document.addEventListener('DOMContentLoaded', function() {
      const modal = document.getElementById('concurrency-conflict-modal');
      if (modal) {
        modal.focus();
      }
    });
  </script>
<% end %>