<%= content_for :title, "Audit Logs" %>

<h1 class="text-2xl font-bold mb-6">Audit Logs</h1>

<table class="table">
  <thead>
    <tr>
      <th>Action</th>
      <th>User</th>
      <th>Created At</th>
      <th>Details</th>
    </tr>
  </thead>
  <tbody>
    <% @audit_logs.each do |log| %>
      <tr>
        <td><%= log.action %></td>
        <td><%= log.user&.email %></td>
        <td><%= log.created_at %></td>
        <td><%= log.details %></td>
      </tr>
    <% end %>
  </tbody>
</table>
