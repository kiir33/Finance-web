<%= content_for :title, "Audit Logs" %>

<h1 class="text-2xl font-bold mb-6">Audit Logs</h1>

<table class="table">
  <thead>
    <tr>
      <th>Action</th>
      <th>User</th>
      <th>Created At</th>
      <th>Details</th>
    </tr>
  </thead>
  <tbody>
    <%= render partial: "shared/audit_log", collection: @audit_logs, as: :audit_log %>
  </tbody>
</table>
