<%= content_for :title, "Loans" %>

<h1 class="text-2xl font-bold mb-6">Loans</h1>

<% if current_user.admin? %>
  <%= link_to "New Loan", new_loan_path, class: "btn btn-primary mb-4" %>
<% end %>

<table class="table">
  <thead>
    <tr>
      <th>Member</th>
      <th>Actions</th>
    </tr>
  </thead>
  <tbody>
    <%= render partial: "shared/loan", collection: @loans, as: :loan %>
  </tbody>
</table>
