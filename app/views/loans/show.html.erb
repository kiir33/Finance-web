<%= content_for :title, "Loan" %>

<h1 class="text-2xl font-bold mb-6">Loan Details</h1>

<div class="card mb-6">
  <p><strong>Member:</strong> <%= link_to @loan.member.member_id, member_path(@loan.member) %></p>
</div>

<%= link_to "Back", loans_path, class: "btn btn-outline ml-2" %>
<% if current_user.admin? %>
  <%= link_to "Edit", edit_loan_path(@loan), class: "btn btn-outline ml-2" %>
<% end %>
