<%= content_for :title, "Group Treasury" %>

<h1 class="text-2xl font-bold mb-6">Group Treasury</h1>

<div class="card mb-6">
  <p><strong>Cash Balance:</strong> <%= number_to_currency(@account.cash_balance || 0) %></p>
  <p><strong>Bank Balance:</strong> <%= number_to_currency(@account.bank_balance || 0) %></p>
  <p><strong>Total:</strong> <%= number_to_currency((@account.cash_balance || 0) + (@account.bank_balance || 0)) %></p>
</div>

<%= link_to "Edit Balances", edit_group_account_path(@account), class: "btn btn-primary" %>
<%= link_to "Group Transactions", group_transactions_path, class: "btn btn-outline ml-2" %>
<%= link_to "Back", root_path, class: "btn btn-outline ml-2" %>
