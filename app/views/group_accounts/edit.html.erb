<%= content_for :title, "Edit Treasury Balances" %>

<h1 class="text-2xl font-bold mb-6">Edit Treasury Balances</h1>

<div class="card">
  <%= form_with model: @account, local: true do |form| %>
    <%= render "shared/form_errors", object: form.object %>
    <%= form.hidden_field :lock_version %>

    <div class="mb-4">
      <%= form.label :cash_balance, "Cash Balance", class: "form-label" %>
      <%= form.text_field :cash_balance, class: "form-input" %>
    </div>

    <div class="mb-4">
      <%= form.label :bank_balance, "Bank Balance", class: "form-label" %>
      <%= form.text_field :bank_balance, class: "form-input" %>
    </div>

    <div>
      <%= form.submit "Update", class: "btn btn-primary" %>
      <%= link_to "Cancel", group_account_path(@account), class: "btn btn-outline ml-2" %>
    </div>
  <% end %>
</div>