<% content_for :title, "User: #{@user.email}" %>

<h1 class="text-2xl font-bold mb-6">User Details</h1>

<div class="card mb-6">
  <table class="table">
    <tbody>
      <tr>
        <th class="w-1/3">Email</th>
        <td><%= @user.email %></td>
      </tr>
      <tr>
        <th class="w-1/3">Role</th>
        <td><%= @user.role.humanize %></td>
      </tr>
      <tr>
        <th class="w-1/3">Public ID</th>
        <td><%= @user.public_id %></td>
      </tr>
      <tr>
        <th class="w-1/3">Created</th>
        <td><%= @user.created_at %></td>
      </tr>
    </tbody>
  </table>
</div>

<div class="flex gap-2">
  <%= link_to "Edit", edit_user_path(@user), class: "btn btn-outline" %>
  <%= link_to "Back", users_path, class: "btn btn-outline" %>
</div>
