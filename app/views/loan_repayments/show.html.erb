<%= content_for :title, "Loan Repayment" %>

<h1 class="text-2xl font-bold mb-6">Loan Repayment</h1>

<div class="card mb-6">
  <p><strong>Loan:</strong> <%= link_to @repayment.loan.client.client_id, client_path(@repayment.loan.client) %></p>
  <p><strong>Amount:</strong> <%= number_to_currency(@repayment.amount) %></p>
</div>

<%= link_to "Back", loan_repayments_path, class: "btn btn-outline" %>
