<%= content_for :title, "Loan Repayments" %>

<h1 class="text-2xl font-bold mb-6">Loan Repayments</h1>

<% if current_user.admin? %>
  <%= link_to "New Repayment", new_loan_repayment_path, class: "btn btn-primary mb-4" %>
<% end %>

<table class="table">
  <thead>
    <tr>
      <th>Loan</th>
      <th>Amount</th>
      <th>Date</th>
    </tr>
  </thead>
  <tbody>
    <%= render partial: "shared/loan_repayment", collection: @repayments, as: :repayment %>
  </tbody>
</table>
