# =============================================================================
# FinanceApp Backend — Production Environment (.env.production.example)
# =============================================================================
# Copy this file to .env (or inject via your platform's secret manager) and
# fill in real values. Never commit .env or any secrets to git (.env* is
# gitignored).
# =============================================================================

# ── Rails ────────────────────────────────────────────────────────────────────
RAILS_ENV=production
RAILS_LOG_TO_STDOUT=1
RAILS_SERVE_STATIC_FILES=1
PORT=3000

# ── Database (managed PostgreSQL, SSL required) ──────────────────────────────
# Example: postgres://user:password@db-host:5432/production?sslmode=require
DATABASE_URL=postgres://financeapp:change-me@db-host:5432/financeapp_production?sslmode=require

# ── Secrets (rotate periodically; inject via platform secret manager) ────────
# SECRET_KEY_BASE: generate with `bin/rails secret` (min 64 chars)
SECRET_KEY_BASE=change-me-to-a-64-character-random-secret-key-base
# API_TOKEN_SECRET: JWT signing secret for API authentication
API_TOKEN_SECRET=change-me-to-a-jwt-signing-secret
# RAILS_MASTER_KEY: from config/credentials.yml.enc (16 hex chars)
RAILS_MASTER_KEY=change-me-to-16-hex-master-key

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (production domain + admin web origins)
CORS_ORIGINS=https://financeapp.example.com,https://admin.financeapp.example.com

# ── Puma ─────────────────────────────────────────────────────────────────────
WEB_CONCURRENCY=2
RAILS_MAX_THREADS=5
PIDFILE=/tmp/pids/server.pid
